# 要使用的模型的名称
MODEL_NAME=
# 模型推理强度：none/low/medium/high/xhigh/max，或服务商支持的自定义值
# MiMo v2.5/v2.6 只支持思考开关：none 关闭，其他值均开启
MODEL_REASONING_EFFORT=none
# OpenAI 或兼容 OpenAI API 服务的 API Key
OPENAI_API_KEY=
# API 基础地址
OPENAI_BASE_URL=
# CodeBadger 服务的URL, 如: http://127.0.0.1:4242/mcp
CodeBadger_URL=
# Docker MCP 服务的URL, 如: http://127.0.0.1:19000/sse
Docker_MCP_URL=

# 桥接服务同时执行的审计/测评任务数，同时也是 Joern 服务池上限（1-16，默认 2）
AUDIT_MAX_CONCURRENCY=2

# 是否开启 LangSmith 追踪(true/false), 表示记录 LangChain / LangGraph / Deep Agents 的运行链路
LANGSMITH_TRACING=
# 用于把追踪数据上传到你的 LangSmith 账号
LANGSMITH_API_KEY=
# LangSmith 项目名, 追踪记录会归档到这个项目下
LANGSMITH_PROJECT=
